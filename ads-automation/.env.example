# העתיקו קובץ זה ל-.env (באותה תיקייה) ומלאו את הערכים.
# .env לעולם לא מועלה ל-git (ראה .gitignore) — אלה סודות אמיתיים, אל תשתפו אותם.

# משלב 3 ב-README: Google Cloud Console → OAuth Client ID (סוג: Desktop app)
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

# משלב 2 ב-README: Google Ads → Tools & Settings → Setup → API Center
GOOGLE_ADS_DEVELOPER_TOKEN=

# מתקבל אוטומטית מהרצת `npm run auth` (שלב 4 ב-README) — אל תמלאו ידנית
GOOGLE_ADS_REFRESH_TOKEN=

# מזהה חשבון הקמפיין עצמו (בפינה הימנית העליונה ב-Google Ads, למשל 123-456-7890)
GOOGLE_ADS_CUSTOMER_ID=

# מזהה חשבון ה-MCC (Manager) שדרכו הונפק ה-developer token — נדרש רק אם הקמפיין
# מנוהל דרך MCC ולא ישירות. אם אין לכם MCC, השאירו ריק.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
